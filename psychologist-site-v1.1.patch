+  var maxFirst = !!CONFIG.MAX_URL && CONFIG.PRIMARY === 'max';
+  var row = el('div', 'row');
+  var a;
+  if (maxFirst) {
+    a = el('a', 'btn', 'Написать в MAX');
+    a.href = CONFIG.MAX_URL;
+  } else {
+    a = el('a', 'btn', 'Написать в Telegram');
+    a.href = 'https://t.me/olyabud?text=' + encodeURIComponent(text);
